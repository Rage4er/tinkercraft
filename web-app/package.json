{
  "name": "tinkercraft-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:yandex": "VITE_PLATFORM=yandex vite",
    "build": "tsc && vite build",
    "build:yandex": "VITE_PLATFORM=yandex tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "test:dev": "concurrently -k -n \"VITE,PROXY\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm dev:yandex\" \"npx @yandex-games/sdk-dev-proxy -h http://localhost:5173 --dev-mode=true\"",
    "test:prod": "concurrently -k -n \"VITE,PROXY\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm dev:yandex\" \"npx @yandex-games/sdk-dev-proxy -h http://localhost:5173 --app-id=572445\"",
    "test:prod:debug": "concurrently -k -n \"VITE,PROXY\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm dev:yandex\" \"npx @yandex-games/sdk-dev-proxy -h http://localhost:5173 --app-id=572445 --csp\"",
    "build:all": "pnpm build && pnpm build:yandex"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "manifold-3d": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "three": "^0.170.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/ysdk": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.9",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
