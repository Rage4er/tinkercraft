#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/manifold-3d@3.5.1_@gltf-transform+core@4.4.0_@gltf-transform+extensions@4.4.0_@gltf-tra_a29e7bb5ecc1689a08da6c9d5094955b/node_modules/manifold-3d/node_modules:/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/manifold-3d@3.5.1_@gltf-transform+core@4.4.0_@gltf-transform+extensions@4.4.0_@gltf-tra_a29e7bb5ecc1689a08da6c9d5094955b/node_modules:/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/manifold-3d@3.5.1_@gltf-transform+core@4.4.0_@gltf-transform+extensions@4.4.0_@gltf-tra_a29e7bb5ecc1689a08da6c9d5094955b/node_modules/manifold-3d/node_modules:/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/manifold-3d@3.5.1_@gltf-transform+core@4.4.0_@gltf-transform+extensions@4.4.0_@gltf-tra_a29e7bb5ecc1689a08da6c9d5094955b/node_modules:/home/small-room/GitHub/tinkercraft/web-app/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../manifold-3d/bin/manifold-cad" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../manifold-3d/bin/manifold-cad" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../manifold-3d/bin/manifold-cad" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../manifold-3d/bin/manifold-cad" "$@"
else
  exec node  "$basedir/../manifold-3d/bin/manifold-cad" "$@"
fi
